
pipeline{
  agent any 
  stages {
    stage ('Groovy Practice'){
     steps {
     script {
         def tool = "Jenkins"
         def environment = "Production"
         def version = 2.0
         if (environment == "Production") {
           echo("Deploying application to Production")
         }
         else echo("Skipping Production deployment")
        
       }
     }
  }
}
}






         
           

    
